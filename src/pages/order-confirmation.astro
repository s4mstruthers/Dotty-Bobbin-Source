---
// Thank-you page after a shop or class-booking checkout.
// The Wix-hosted checkout redirects here with ?orderId=<eCommerce order id> once the order is
// placed (callbacks.thankYouPageUrl in src/wix/storefront/cart.ts and
// src/wix/bookings/booking-core.ts). KEEP THIS ADDRESS: both checkouts point at it.
// Ticket orders for retreats/events use /event-confirmation instead.
//
// Landing here with an orderId IS the success signal (Wix only uses this URL after the order
// completes). Without one (a direct visit) the page says so plainly; it never shows a fake
// confirmation. No order details are invented: the confirmation email carries those.
import SiteLayout from "../layouts/SiteLayout.astro";
import { BUSINESS } from "../content/site";
import BookedClassCalendar from "../components/bookings/BookedClassCalendar";

const address = BUSINESS.address.join(", ");
---
<SiteLayout title="Order confirmed">
  <div class="wrap max-w-2xl">
    <!-- Shown when Wix sent the visitor here after a completed order -->
    <section id="order-confirmed" class="py-10 text-center" hidden>
      <p class="eyebrow">Order confirmed</p>
      <h1 class="mt-2 text-4xl text-sage">Thank you!</h1>
      <p class="mt-4 leading-relaxed">
        Your order has been placed and a confirmation email is on its way to you.
      </p>

      <div class="mt-10 grid gap-4 text-left sm:grid-cols-2">
        <div class="rounded-lg bg-secondary p-5">
          <h2 class="text-lg text-sage">Bought from the shop?</h2>
          <p class="mt-2 text-sm leading-relaxed">
            Shop orders are collected from {address}. Please call or text {`${BUSINESS.owner.split(" ")[0]} on `}<a href={`tel:${BUSINESS.phone.replace(/\s/g, "")}`}>{BUSINESS.phone}</a> to arrange a
            time, or pick it up at your next class.
          </p>
        </div>
        <div class="rounded-lg bg-secondary p-5">
          <h2 class="text-lg text-sage">Booked a class?</h2>
          <p class="mt-2 text-sm leading-relaxed">
            Your booking is confirmed. You can see your classes, and change or cancel them where
            the booking policy allows, in <a href="/account">My account</a>.
          </p>
          <BookedClassCalendar client:only="react" />
        </div>
        <div class="rounded-lg bg-secondary p-5 sm:col-span-2">
          <h2 class="text-lg text-sage">Bought a gift card?</h2>
          <p class="mt-2 text-sm leading-relaxed">
            The gift card code is on its way by email — to the person you chose, or to you. It's entered at checkout, for classes, retreats and anything in the shop.
          </p>
        </div>
      </div>

      <div class="mt-10 flex flex-wrap justify-center gap-3">
        <a href="/shop" class="btn">Back to the shop</a>
        <a href="/services" class="btn">See classes</a>
      </div>
    </section>

    <!-- Shown on a direct visit with no order in the address -->
    <section id="no-order" class="py-16 text-center">
      <p class="text-lg font-semibold">No order to show</p>
      <p class="mt-2 text-sm text-muted-foreground">
        If you've just placed an order, check your email for the confirmation.
      </p>
      <a href="/" class="mt-4 inline-block underline">Go to the home page</a>
    </section>
  </div>
</SiteLayout>

<script>
  // Wix appends ?orderId= only after a completed checkout; switch to the confirmation view.
  if (new URLSearchParams(window.location.search).get("orderId")) {
    document.getElementById("order-confirmed")?.removeAttribute("hidden");
    document.getElementById("no-order")?.setAttribute("hidden", "");
  }
</script>
