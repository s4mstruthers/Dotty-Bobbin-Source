---
// Policies page, linked from the footer. The text goes in POLICIES in src/content/site.ts.
import SiteLayout from "../layouts/SiteLayout.astro";
import Placeholder from "../components/Placeholder.astro";
import { POLICIES } from "../content/site";
---
<SiteLayout title="Terms & Conditions">
  <div class="wrap max-w-3xl">
    <h1 class="text-4xl text-sage">Terms &amp; Conditions</h1>
    {POLICIES.length > 0 ? (
      POLICIES.map((p) => (
        <section class="mt-10">
          <h2 class="text-xl text-sage sm:text-2xl">{p.title}</h2>
          <div class="mt-3 space-y-3 leading-relaxed">{p.paragraphs.map((t) => <p>{t}</p>)}</div>
        </section>
      ))
    ) : (
      <div class="mt-8">
        <Placeholder title="Policies coming soon" note="Booking, cancellation, privacy and shop policies go in src/content/site.ts (POLICIES)." />
      </div>
    )}
  </div>
</SiteLayout>
