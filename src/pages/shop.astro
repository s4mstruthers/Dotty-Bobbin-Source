---
// The Studio Shop (/shop). Products and categories are fetched SERVER-SIDE (SEO) and handed to
// the ShopView island; category switches then filter live. Frontmatter is the kit's skeleton.
import SiteLayout from "../layouts/SiteLayout.astro";
import ShopView from "../components/storefront/ShopView";
import { fetchProducts, fetchCategories } from "../wix/storefront/catalog";
import type { Category, ProductSummary } from "../wix/storefront/types";
import { SHOP, SHOP_COLLECTION_NOTE } from "../content/site";

let products: ProductSummary[] = [];
let categories: Category[] = [];
try {
  [products, categories] = await Promise.all([fetchProducts({ limit: 24 }), fetchCategories()]);
} catch {
  // Guarded: an unhandled SSR throw truncates the response mid-stream; the island
  // renders the empty state instead.
}
// Patterns have their own page; the shop points there while the category exists in Wix.
const patterns = categories.find((c) => c.slug === SHOP.patternsCategorySlug);
---
<SiteLayout title="Studio Shop" description="The Dotty Bobbin studio shop: the notions, kits and sewing folders Saskia uses in class.">
  <div class="wrap">
    <header class="mb-6 max-w-2xl">
      <h1 class="text-3xl text-sage sm:text-4xl">Studio Shop</h1>
      <p class="mt-2">A small selection of the notions and kits I use in class, so you can carry on sewing at home.</p>
      {/* One line instead of a note and two big cards (26 Nov 2026): Patterns is one of the
          category links below; the gift card is a link here. */}
      <p class="mt-2 text-sm text-muted-foreground">
        {SHOP_COLLECTION_NOTE} Buying for someone? <a href="/gift-card" class="font-semibold text-sage-deep underline decoration-blush decoration-2 underline-offset-4">Gift cards</a>
      </p>
      {patterns && (
        <p class="mt-3 text-base">
          {SHOP.shopPatternsLine} <a href={SHOP.patternsHref} class="font-semibold text-sage-deep underline decoration-blush decoration-2 underline-offset-4">Sewing patterns</a>
        </p>
      )}
    </header>
    <ShopView client:load initialProducts={products} initialCategories={categories} />
  </div>
</SiteLayout>
