---
// Contact page — the message form (a Wix form), phone (call or text), email, address and a small
// map. Details come from BUSINESS in src/content/site.ts.
import SiteLayout from "../layouts/SiteLayout.astro";
import ContactForm from "../components/ContactForm";
import { BUSINESS, HOME } from "../content/site";
import { getForm } from "../wix/forms/forms";
import type { FormDto } from "../wix/forms/types";
// The map and directions go to the house's own pin when it's set (Google doesn't know the name
// Felcote), else to the road and postcode. Directions use Google's documented Maps URLs. With a
// pin, the map is Google's "Embed a map" form (centre, ~1.2 km across, and the Dotty Bobbin
// place marked): the simple ?q=lat,lng embed zooms past the imagery and shows a grey box.
const mapTarget = BUSINESS.mapPin ? `${BUSINESS.mapPin.lat},${BUSINESS.mapPin.lng}` : BUSINESS.mapQuery;
const pin = BUSINESS.mapPin;
const place = BUSINESS.mapPlace.id ? `!3m3!1m2!1s${encodeURIComponent(BUSINESS.mapPlace.id)}!2s${encodeURIComponent(BUSINESS.mapPlace.name)}` : "";
const mapSrc = pin
  ? `https://www.google.com/maps/embed?pb=!1m${place ? 18 : 14}!1m12!1m3!1d1200!2d${pin.lng}!3d${pin.lat}!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1${place}!5e0!3m2!1sen!2suk`
  : `https://www.google.com/maps?q=${encodeURIComponent(mapTarget)}&output=embed`;
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(mapTarget)}`;

// The site's own Wix form "Dotty Bobbin Studio Inquiry" (Wix dashboard > Forms). Its fields,
// choices, button text and required marks are edited there; the page follows with no code change.
const FORM_ID = "14661f78-a00d-416a-9206-d1fe5abb814a";
let form: FormDto | null = null;
try {
  form = await getForm(FORM_ID);
} catch {
  // Guarded: an SSR throw would cut the page off mid-stream. The island loads the form itself
  // and shows a friendly message (with the email address) if it fails again.
}
---
<SiteLayout title="Contact" description={`Contact ${BUSINESS.name}: send a message or email ${BUSINESS.email}. Sewing classes in Felden, Hemel Hempstead.`}>
  <div class="wrap">
    <header class="max-w-2xl">
      <p class="eyebrow">Felden, Hemel Hempstead</p>
      <h1 class="mt-2 text-4xl text-sage sm:text-5xl">Contact</h1>
      <p class="mt-3 text-lg">{HOME.contactText}</p>
    </header>

    <!-- The quick ways to reach me: three equal cards in a row (stacked on phones, call first). -->
    <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      <div class="flex flex-col rounded-lg bg-secondary p-6">
        <h2 class="text-xl text-sage">Call or text</h2>
        <p class="mt-1 text-lg font-semibold">{BUSINESS.phone}</p>
        <div class="mt-auto flex flex-wrap items-center gap-3 pt-4">
          <a href={`tel:${BUSINESS.phoneIntl}`} class="btn">Call me</a>
          <a href={`sms:${BUSINESS.phoneIntl}`} class="link-pill bg-background">Send a text</a>
        </div>
      </div>
      <div class="flex flex-col rounded-lg bg-secondary p-6">
        <h2 class="text-xl text-sage">Email</h2>
        <p class="mt-1 break-words text-lg font-semibold">{BUSINESS.email}</p>
        <div class="mt-auto flex flex-wrap items-center gap-3 pt-4">
          <a href={`mailto:${BUSINESS.email}`} class="btn">{HOME.contactButton}</a>
          <button type="button" class="link-pill bg-background" data-copy={BUSINESS.email} aria-live="polite" hidden>Copy email address</button>
        </div>
      </div>
      <div class="flex flex-col rounded-lg bg-secondary p-6 sm:col-span-2 lg:col-span-1">
        <h2 class="text-xl text-sage">Visit</h2>
        <address class="mt-1 not-italic leading-relaxed">
          <span class="block">{BUSINESS.address.slice(0, 2).join(", ")}</span>
          <span class="block">{BUSINESS.address.slice(2).join(" ")}</span>
        </address>
        <p class="mt-3 text-sm font-semibold">{BUSINESS.hours}</p>
      </div>
    </div>

    <!-- The message form beside the map, both the same height. -->
    <div class="mt-6 grid gap-6 lg:grid-cols-[1.4fr_1fr]">
      <section class="rounded-lg border border-border p-6 sm:p-8" aria-labelledby="message-title">
        <h2 id="message-title" class="text-2xl text-sage sm:text-3xl">Send me a message</h2>
        <div class="mt-6">
          <ContactForm client:load formId={FORM_ID} initialForm={form ?? undefined} fallbackEmail={BUSINESS.email} />
        </div>
      </section>

      <section class="flex flex-col overflow-hidden rounded-lg border border-border" aria-labelledby="where-title">
        <div class="p-6 sm:p-8">
          <h2 id="where-title" class="text-2xl text-sage sm:text-3xl">Where to find me</h2>
          <p class="mt-2 text-sm leading-relaxed text-muted-foreground">Classes and retreats are held at my home in Felden, Hemel Hempstead. Day trips meet here first.</p>
          <div class="mt-4 flex flex-wrap items-center justify-between gap-3">
            <p class="font-semibold">{BUSINESS.address.slice(0, 2).join(", ")}</p>
            <a href={directionsUrl} target="_blank" rel="noopener" class="link-pill">Get directions</a>
          </div>
        </div>
        <iframe
          title={`Map of ${BUSINESS.address.join(", ")}`}
          src={mapSrc}
          class="block min-h-72 w-full flex-1 border-0"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </section>
    </div>
  </div>
</SiteLayout>
