---
// About page — Saskia's own text, verbatim. Paste it into ABOUT in src/content/site.ts
// (one string per paragraph). Nothing here is written for her.
import SiteLayout from "../layouts/SiteLayout.astro";
import Placeholder from "../components/Placeholder.astro";
import { ABOUT, ABOUT_TITLE, BUSINESS } from "../content/site";
---
<SiteLayout title="About" description={`About ${BUSINESS.owner} and ${BUSINESS.name}, sewing classes and retreats in Felden, Hemel Hempstead.`}>
  <div class="wrap grid gap-10 md:grid-cols-[1fr_1.6fr] md:items-start">
    <div class="dots-pink mx-auto w-full max-w-xs rounded-full p-3 md:sticky md:top-28">
        <div class="relative aspect-square w-full overflow-hidden rounded-full">
          <img src="/saskia-800.jpg" srcset="/saskia-480.jpg 480w, /saskia-800.jpg 800w" sizes="320px" alt={`${BUSINESS.owner}, who runs ${BUSINESS.name}`} width="800" height="800" class="absolute inset-0 h-full w-full object-cover" />
        </div>
      </div>
    <article class="max-w-2xl">
      <p class="eyebrow">{BUSINESS.name} · sewing classes &amp; retreats</p>
      <h1 class="mt-2 text-4xl text-sage sm:text-5xl">{ABOUT_TITLE}</h1>
      {ABOUT.length > 0 ? (
        <div class="mt-6 space-y-4 text-lg leading-relaxed">{ABOUT.map((p) => <p>{p}</p>)}</div>
      ) : (
        <div class="mt-6">
          <Placeholder title="Saskia's About text goes here" note="Her own words, added in src/content/site.ts (ABOUT)." />
        </div>
      )}
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/services" class="btn">Book a class</a>
        <a href="/contact" class="link-pill">Get in touch</a>
      </div>
    </article>
  </div>
</SiteLayout>
