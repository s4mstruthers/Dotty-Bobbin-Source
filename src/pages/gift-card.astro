---
// The gift card page (/gift-card): the site's Wix gift card, bought through the same cart and
// Wix checkout as the shop. Wix issues the card and emails the code once the order is paid; the
// recipient redeems it at checkout for classes, retreats or shop orders. The product is read
// server-side (guarded like every SSR read); the buying panel is an island.
import SiteLayout from "../layouts/SiteLayout.astro";
import GiftCardView from "../components/storefront/GiftCardView";
import NoPhoto from "../components/ui/NoPhoto";
import { fetchGiftCardProduct } from "../wix/gift-cards/gift-card";
import type { GiftCardProduct } from "../wix/gift-cards/types";

let product: GiftCardProduct | null = null;
let failed = false;
try {
  product = await fetchGiftCardProduct();
} catch {
  failed = true;
}
---
<SiteLayout title="Gift Card" description="Give the gift of sewing: a Dotty Bobbin gift card for classes, retreats or anything in the shop.">
  <div class="wrap">
    <nav aria-label="Breadcrumb" class="mb-6 text-sm text-muted-foreground">
      <a href="/shop" class="no-underline hover:underline">Studio Shop</a>
      <span aria-hidden="true"> › </span>
      <span class="text-foreground">Gift Card</span>
    </nav>

    {product ? (
      <div class="grid grid-cols-1 gap-8 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-x-12">
        <div class="aspect-square overflow-hidden rounded-lg bg-secondary">
          {product.imageUrl ? (
            <img src={product.imageUrl} alt={product.name} class="h-full w-full object-cover" loading="eager" />
          ) : (
            <NoPhoto motif="bag" tone="pink" />
          )}
        </div>
        <section class="min-w-0">
          <p class="eyebrow">Gift Card</p>
          <h1 class="mt-1 text-3xl text-sage sm:text-4xl">{product.name}</h1>
          {product.description && <p class="mt-3 leading-relaxed">{product.description}</p>}
          {/* The dashboard description often states the validity itself; don't say it twice. */}
          {product.expiryLabel && !/valid|expire/i.test(product.description) && <p class="mt-2 text-sm text-muted-foreground">{product.expiryLabel} from the date of purchase.</p>}
          <div class="mt-6 rounded-lg border border-border p-5 sm:p-6">
            <GiftCardView client:load product={product} />
          </div>
          <p class="mt-4 text-sm text-muted-foreground">
            To use a gift card, enter its code at checkout — it works for classes, retreats and events, and anything in the shop.
          </p>
        </section>
      </div>
    ) : (
      <div class="rounded-lg bg-secondary p-8 text-center">
        <h1 class="text-2xl text-sage">Gift cards</h1>
        <p class="mt-2 text-sm text-muted-foreground">
          {failed ? "The gift card couldn't be loaded just now. Please try again in a moment." : "Gift cards aren't on sale at the moment."}
        </p>
        <a href="/shop" class="mt-4 inline-block underline">Back to the shop</a>
      </div>
    )}
  </div>
</SiteLayout>
