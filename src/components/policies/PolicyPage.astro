---
// One policy page (/terms, /refunds, /delivery, /privacy-policy). The wording is in
// src/content/policies.ts; this only lays it out.
import SiteLayout from "../../layouts/SiteLayout.astro";
import { BUSINESS } from "../../content/site";
import { ALL_POLICIES, type Policy } from "../../content/policies";

interface Props {
  policy: Policy;
}
const { policy } = Astro.props;

const escape = (s: string) => s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
const linkClass = "underline decoration-blush decoration-2 underline-offset-4";
// The email address and phone number become links wherever the text mentions them.
const linkify = (s: string) =>
  escape(s)
    .replaceAll(BUSINESS.email, `<a href="mailto:${BUSINESS.email}" class="${linkClass}">${BUSINESS.email}</a>`)
    .replaceAll(BUSINESS.phone, `<a href="tel:${BUSINESS.phoneIntl}" class="${linkClass}">${BUSINESS.phone}</a>`)
    .replace("ico.org.uk", `<a href="https://ico.org.uk" target="_blank" rel="noopener" class="${linkClass}">ico.org.uk</a>`);
const others = ALL_POLICIES.filter((p) => p.slug !== policy.slug);
---
<SiteLayout title={policy.title} description={policy.description}>
  <div class="wrap">
    <article class="max-w-3xl">
      <p class="eyebrow">{BUSINESS.name}</p>
      <h1 class="mt-2 text-4xl text-sage">{policy.title}</h1>
      <p class="mt-3 text-sm text-muted-foreground">Last updated: {policy.lastUpdated}</p>
      {policy.blocks.map((b) => (
        <section class="mt-8">
          {b.heading && <h2 class="text-xl text-sage sm:text-2xl">{b.heading}</h2>}
          {b.paragraphs?.length ? <div class="mt-3 space-y-3 leading-relaxed">{b.paragraphs.map((t) => <p set:html={linkify(t)} />)}</div> : null}
          {b.bullets?.length ? <ul class="mt-3 list-disc space-y-2 pl-5 leading-relaxed">{b.bullets.map((t) => <li set:html={linkify(t)} />)}</ul> : null}
          {b.after?.length ? <div class="mt-3 space-y-3 leading-relaxed">{b.after.map((t) => <p set:html={linkify(t)} />)}</div> : null}
        </section>
      ))}
      <nav class="mt-12 border-t border-border pt-6 text-sm" aria-label="Other policies">
        <p class="eyebrow">Also see</p>
        <ul class="mt-3 flex flex-wrap gap-x-6 gap-y-2">
          {others.map((p) => <li><a href={`/${p.slug}`} class={linkClass}>{p.title}</a></li>)}
        </ul>
      </nav>
    </article>
  </div>
</SiteLayout>
