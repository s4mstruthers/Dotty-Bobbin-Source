---
// "Dotty snow": polka dots in Christmas colours drifting down, slowly and softly, behind whatever
// sits on top. Decorative (hidden from screen readers) and never in the way of a click. It fills
// its positioned parent; phones get half as many dots. With "reduce motion" on there is no snow.
interface Props {
  class?: string;
  count?: number;
}
const { class: className, count = 22 } = Astro.props;

// Fixed "random" values, so the page is the same on every visit (no flicker between server and browser).
const rand = (i: number, k: number) => {
  const v = Math.sin(i * 12.9898 + k * 78.233) * 43758.5453;
  return v - Math.floor(v);
};
const COLOURS = ["bg-berry/45", "bg-gold/70", "bg-holly/40", "bg-dotty/50"];
const dots = Array.from({ length: count }, (_, i) => ({
  left: (rand(i, 1) * 100).toFixed(1),
  size: Math.round(6 + rand(i, 2) * 9),
  fall: (14 + rand(i, 3) * 12).toFixed(1),
  delay: (-rand(i, 4) * 26).toFixed(1),
  drift: Math.round((rand(i, 5) - 0.5) * 50),
  wobble: (2.5 + rand(i, 6) * 2).toFixed(1),
  colour: COLOURS[i % COLOURS.length],
  phoneHidden: i % 2 === 1,
}));
---

<div class:list={["dot-snow", className]} aria-hidden="true">
  {dots.map((d) => (
    <span
      class:list={["flake", d.phoneHidden && "phone-off"]}
      style={`left:${d.left}%;animation-duration:${d.fall}s;animation-delay:${d.delay}s`}
    >
      <span
        class:list={["block rounded-full", d.colour]}
        style={`width:${d.size}px;height:${d.size}px;--drift:${d.drift}px;animation-duration:${d.wobble}s`}
      />
    </span>
  ))}
</div>

<style>
  .dot-snow {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    container-type: size;
  }
  .flake {
    position: absolute;
    top: -20px;
    display: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .flake {
      display: block;
      animation-name: fall;
      animation-timing-function: linear;
      animation-iteration-count: infinite;
    }
    .flake > span {
      animation: wobble ease-in-out infinite alternate;
    }
  }
  /* After the rule above, so it wins: phones get half the dots. */
  @media (max-width: 639.98px) {
    .phone-off {
      display: none;
    }
  }
  @keyframes fall {
    0% {
      transform: translateY(0);
      opacity: 0;
    }
    8%,
    88% {
      opacity: 1;
    }
    100% {
      transform: translateY(calc(100cqh + 40px));
      opacity: 0;
    }
  }
  @keyframes wobble {
    from {
      transform: translateX(calc(var(--drift) * -0.5));
    }
    to {
      transform: translateX(calc(var(--drift) * 0.5));
    }
  }
</style>
