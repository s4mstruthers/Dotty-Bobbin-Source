---
// A snowflake in cross stitch: a 9×9 chart, one X per stitch, in the current text colour.
// Decorative (hidden from screen readers). `twinkle` makes it glint now and then; with "reduce
// motion" on it stays still.
interface Props {
  class?: string;
  twinkle?: boolean;
  /** Seconds to wait before the first glint, so several don't glint together. */
  delay?: number;
}
const { class: className, twinkle = false, delay = 0 } = Astro.props;

const CHART = [
  "...XXX...",
  ".X..X..X.",
  "..X.X.X..",
  "X.......X",
  "XXX.X.XXX",
  "X.......X",
  "..X.X.X..",
  ".X..X..X.",
  "...XXX...",
];
const CELL = 10;
const stitches = CHART.flatMap((row, r) => [...row].flatMap((ch, c) => (ch === "X" ? [{ x: c * CELL, y: r * CELL }] : [])));
---

<svg
  class:list={["stitch-flake", twinkle && "twinkle", className]}
  style={twinkle ? `animation-delay:${delay}s` : undefined}
  viewBox="0 0 90 90"
  fill="none"
  stroke="currentColor"
  stroke-width="2.4"
  stroke-linecap="round"
  aria-hidden="true"
  focusable="false"
>
  {stitches.map(({ x, y }) => <path d={`M${x + 2.5} ${y + 2.5}L${x + 7.5} ${y + 7.5}M${x + 7.5} ${y + 2.5}L${x + 2.5} ${y + 7.5}`} />)}
</svg>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .twinkle {
      animation: twinkle 7s ease-in-out infinite;
      transform-origin: center;
    }
  }
  /* Still most of the time, then a slow turn and glint. */
  @keyframes twinkle {
    0%,
    70%,
    100% {
      transform: rotate(0deg) scale(1);
      opacity: 0.9;
    }
    82% {
      transform: rotate(30deg) scale(1.12);
      opacity: 1;
    }
  }
</style>
