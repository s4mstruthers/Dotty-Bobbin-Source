---
// A hat for the Dotty Bobbin bird, drawn like the logo (black outline, flat colour): a Santa hat at
// Christmas, its tip flopping back behind her head; in winter a knitted bobble hat, navy with white
// spots and a pink bobble; in spring a straw sun hat with a pink ribbon and a daisy. All sit level on
// the same band (x 18–90, bottom at y 71 of the 100×80 drawing), so one placement fits every hat:
// put it over the bird with `class` (absolute, left/top/width),
// the band centred on her crown and its lower edge just above her eye. Decorative (hidden from
// screen readers).
// `wiggle`: she gives her head a little shake now and then; with "reduce motion" on the hat stays put.
import type { Season } from "../../lib/season";

interface Props {
  season: Season;
  class?: string;
  wiggle?: boolean;
}
const { season, class: className, wiggle = false } = Astro.props;
const RIBS = [26, 33, 40, 47, 54, 61, 68, 75, 82];
// The daisy on the sun hat's ribbon: six petals round a yellow middle.
const DAISY = { x: 70, y: 47 };
const DAISY_PETALS = Array.from({ length: 6 }, (_, i) => {
  const a = (i * Math.PI) / 3;
  return [DAISY.x + Math.cos(a) * 4.6, DAISY.y + Math.sin(a) * 4.6];
});
const SPOTS = [
  [40, 41],
  [54, 31],
  [68, 41],
  [47, 49],
  [61, 49],
];
---

<svg class:list={["bird-hat", wiggle && "wiggle", className]} viewBox="0 0 100 80" aria-hidden="true" focusable="false">
  <g class="stroke-ink" stroke-width="2.2" stroke-linejoin="round">
    {season === "christmas" ? (
      <>
        <!-- The hat, its tip folded back to the left. -->
        <path class="fill-berry" d="M27 58 C29 45 31 37 37 31 C30 31 23 32 16 35 C22 20 35 8 53 7 C70 6 80 20 84 58 Z" />
        <!-- A shadow under the fold, so the tip reads as hanging over. -->
        <path d="M37 31 C30 31 23 32 16 35 C24 33 31 34 36 36 Z" class="fill-ink" opacity="0.25" stroke="none" />
        <!-- The fur brim and the pompom. -->
        <rect x="18" y="53" width="72" height="18" rx="9" class="fill-snow" />
        <circle cx="14" cy="37" r="8.5" class="fill-snow" />
      </>
    ) : season === "spring" ? (
      <>
        <!-- The straw crown and its pink ribbon. -->
        <path class="fill-straw" d="M29 64 C29 40 39 28 54 28 C69 28 79 40 79 64 Z" />
        <rect x="30" y="43" width="48" height="9" class="fill-dotty" stroke-width="1.8" />
        <!-- The wide brim, in front of the crown. -->
        <ellipse cx="54" cy="63" rx="44" ry="8" class="fill-straw" />
        <ellipse cx="54" cy="63" rx="36" ry="5" fill="none" stroke-width="1.2" opacity="0.3" />
        <!-- A daisy tucked into the ribbon. -->
        {DAISY_PETALS.map(([x, y]) => <circle cx={x} cy={y} r="3.1" class="fill-white" stroke-width="1.2" />)}
        <circle cx={DAISY.x} cy={DAISY.y} r="2.8" class="fill-primrose" stroke-width="1.2" />
      </>
    ) : (
      <>
        <!-- The knitted crown, with spots. -->
        <path class="fill-navy" d="M22 58 C20 34 34 18 54 18 C74 18 88 34 86 58 Z" />
        {SPOTS.map(([x, y]) => <circle cx={x} cy={y} r="3.4" class="fill-white" stroke="none" />)}
        <!-- The ribbed band. -->
        <rect x="18" y="52" width="72" height="19" rx="7" class="fill-ice" />
        {RIBS.map((x) => <path d={`M${x} 56V67`} stroke-width="1.6" opacity="0.35" stroke-linecap="round" />)}
        <!-- The bobble. -->
        <circle cx="54" cy="14" r="10" class="fill-dotty" />
        <path d="M49 10l3 3M57 9l-2 4M50 18l3-2M58 17l-2-2" stroke-width="1.4" opacity="0.4" stroke-linecap="round" />
      </>
    )}
  </g>
</svg>

<style>
  .bird-hat {
    overflow: visible;
    transform-origin: 54% 78%;
    pointer-events: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .wiggle {
      animation: wiggle 6s ease-in-out infinite;
    }
  }
  /* Straight most of the time; a quick shake, then straight again. */
  @keyframes wiggle {
    0%,
    78%,
    100% {
      transform: rotate(0deg);
    }
    84% {
      transform: rotate(-4deg);
    }
    90% {
      transform: rotate(3deg);
    }
    95% {
      transform: rotate(-1.5deg);
    }
  }
</style>
