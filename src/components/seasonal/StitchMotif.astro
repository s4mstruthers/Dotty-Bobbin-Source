---
// A little motif in cross stitch on a 9×9 chart, one X per stitch: a snowflake (Christmas), a
// four-petal flower (Easter) or a jack-o'-lantern (Halloween). X stitches are in the current text
// colour; O stitches (a flower's centre, a pumpkin's stalk) take `centre`. Decorative (hidden from screen readers). `twinkle` makes it glint now and
// then; with "reduce motion" on it stays still.
interface Props {
  motif?: "snowflake" | "flower" | "pumpkin";
  /** Text-colour class for the O stitches: a flower's centre, a pumpkin's stalk. */
  centre?: string;
  class?: string;
  twinkle?: boolean;
  /** Seconds to wait before the first glint, so several don't glint together. */
  delay?: number;
}
const { motif = "snowflake", centre, class: className, twinkle = false, delay = 0 } = Astro.props;

const CHARTS = {
  snowflake: [
    "...XXX...",
    ".X..X..X.",
    "..X.X.X..",
    "X.......X",
    "XXX.X.XXX",
    "X.......X",
    "..X.X.X..",
    ".X..X..X.",
    "...XXX...",
  ],
  flower: [
    "....X....",
    "...XXX...",
    "...XXX...",
    ".XX.O.XX.",
    "XXXOOOXXX",
    ".XX.O.XX.",
    "...XXX...",
    "...XXX...",
    "....X....",
  ],
  pumpkin: [
    "....O....",
    "...OO....",
    ".XXXXXXX.",
    "XXXXXXXXX",
    "XX.XXX.XX",
    "XXXXXXXXX",
    "XX.....XX",
    ".XXXXXXX.",
    "..XXXXX..",
  ],
};
const CELL = 10;
const cross = (x: number, y: number) => `M${x + 2.5} ${y + 2.5}L${x + 7.5} ${y + 7.5}M${x + 7.5} ${y + 2.5}L${x + 2.5} ${y + 7.5}`;
const stitches = (mark: string) =>
  CHARTS[motif].flatMap((row, r) => [...row].flatMap((ch, c) => (ch === mark ? [cross(c * CELL, r * CELL)] : []))).join("");
const petals = stitches("X");
const middle = stitches("O");
---

<svg
  class:list={["stitch-motif", twinkle && "twinkle", className]}
  style={twinkle ? `animation-delay:${delay}s` : undefined}
  viewBox="0 0 90 90"
  fill="none"
  stroke="currentColor"
  stroke-width="2.4"
  stroke-linecap="round"
  aria-hidden="true"
  focusable="false"
>
  <path d={petals} />
  {middle && <path d={middle} class={centre} stroke="currentColor" />}
</svg>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .twinkle {
      animation: twinkle 7s ease-in-out infinite;
      transform-origin: center;
    }
  }
  /* Still most of the time, then a slow turn and glint. */
  @keyframes twinkle {
    0%,
    70%,
    100% {
      transform: rotate(0deg) scale(1);
      opacity: 0.9;
    }
    82% {
      transform: rotate(30deg) scale(1.12);
      opacity: 1;
    }
  }
</style>
