---
// A Santa hat for the Dotty Bobbin bird, drawn like the logo (black outline, flat colour), its tip
// flopping back behind her head. Place it over the bird with `class` (absolute, left/top/width).
// Decorative (hidden from screen readers). `wiggle`: she gives her head a little shake now and then;
// with "reduce motion" on the hat stays put.
interface Props {
  class?: string;
  wiggle?: boolean;
}
const { class: className, wiggle = false } = Astro.props;
---

<svg class:list={["santa-hat", wiggle && "wiggle", className]} viewBox="0 0 100 80" aria-hidden="true" focusable="false">
  <g class="stroke-ink" stroke-width="2.2" stroke-linejoin="round">
    <!-- The hat, its tip folded back to the left. -->
    <path class="fill-berry" d="M27 58 C29 45 31 37 37 31 C30 31 23 32 16 35 C22 20 35 8 53 7 C70 6 80 20 84 58 Z" />
    <!-- A shadow under the fold, so the tip reads as hanging over. -->
    <path d="M37 31 C30 31 23 32 16 35 C24 33 31 34 36 36 Z" class="fill-ink" opacity="0.25" stroke="none" />
    <!-- The fur brim and the pompom. -->
    <rect x="18" y="53" width="72" height="18" rx="9" class="fill-snow" />
    <circle cx="14" cy="37" r="8.5" class="fill-snow" />
  </g>
</svg>

<style>
  .santa-hat {
    overflow: visible;
    transform: rotate(-9deg);
    transform-origin: 54% 78%;
    pointer-events: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .wiggle {
      animation: wiggle 6s ease-in-out infinite;
    }
  }
  @keyframes wiggle {
    0%,
    78%,
    100% {
      transform: rotate(-9deg);
    }
    84% {
      transform: rotate(-14deg);
    }
    90% {
      transform: rotate(-5deg);
    }
    95% {
      transform: rotate(-11deg);
    }
  }
</style>
