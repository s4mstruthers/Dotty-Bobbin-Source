---
// The site chrome for every page: header (logo, menu, account, cart), footer, and the cart
// drawer. Keep these shipped pieces when editing:
//   - <slot name="seo-tags" /> in <head> (owner-editable SEO for item pages lands there,
//     including the <title> — ours is printed only when that slot is empty)
//   - the global.css import (Tailwind + the design tokens)
//   - one <CartButton> in the header and one <CartDrawer> per page (client:only)
// The menu itself is in src/content/site.ts (NAV).
import CartButton from "../components/storefront/CartButton";
import CartDrawer from "../components/storefront/CartDrawer";
import AccountLink from "../components/AccountLink";
import { BUSINESS, NAV } from "../content/site";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  /** Pages with their own full-bleed sections (home) skip the default top padding. */
  bare?: boolean;
  /** The picture shown when the page is shared (a path in /public or a full URL). */
  image?: string;
  /** Keep the page out of search results (log in, my account, not found). */
  noindex?: boolean;
}
const { title, description, bare = false, image = "/saskia-800.jpg", noindex = false } = Astro.props;
// A title that already starts with the business name (the home page's) is used as it is.
const fullTitle = title === BUSINESS.name || title.startsWith(`${BUSINESS.name} ·`) ? title : `${title} · ${BUSINESS.name}`;
const path = Astro.url.pathname;
const isActive = (href: string) => (href === "/" ? path === "/" : path === href || path.startsWith(`${href}/`));
const year = new Date().getFullYear();
// Item pages bring the owner's own SEO tags (title, description, sharing, canonical) in the
// seo-tags slot; every other page gets ours. Behind Wix's proxy the request URL is internal, so
// the public address comes from x-wix-forwarded-url (as on the item pages).
const ownSeo = !Astro.slots.has("seo-tags");
const forwardedUrl = Astro.request.headers.get("x-wix-forwarded-url");
const publicUrl =
  forwardedUrl && URL.canParse(forwardedUrl) && /^https?:$/.test(new URL(forwardedUrl).protocol) ? new URL(forwardedUrl) : Astro.url;
const canonical = new URL(publicUrl.pathname, publicUrl.origin).href;
const shareImage = new URL(image, publicUrl.origin).href;
// Where "Back" goes when there is no page of this site to go back to (a link from an email or
// search): the page's parent section, else home.
const PARENTS: Record<string, string> = { services: "/services", products: "/shop", category: "/shop", events: "/events" };
const [, section, item] = path.split("/");
const backHref = (item && PARENTS[section]) || "/";
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {ownSeo && (
      <>
        <title>{fullTitle}</title>
        {description && <meta name="description" content={description} />}
        <link rel="canonical" href={canonical} />
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content={BUSINESS.name} />
        <meta property="og:locale" content="en_GB" />
        <meta property="og:title" content={fullTitle} />
        {description && <meta property="og:description" content={description} />}
        <meta property="og:url" content={canonical} />
        <meta property="og:image" content={shareImage} />
        <meta name="twitter:card" content="summary" />
        <meta name="twitter:title" content={fullTitle} />
        {description && <meta name="twitter:description" content={description} />}
        <meta name="twitter:image" content={shareImage} />
      </>
    )}
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#ffffff" />
    <slot name="seo-tags" />
  </head>
  <body class="flex min-h-screen flex-col">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-control focus:bg-background focus:px-4 focus:py-2">Skip to content</a>

    <header class="sticky top-0 z-40 border-b border-border/70 bg-background/90 backdrop-blur">
      <div class="wrap flex h-[76px] items-center justify-between gap-4 sm:h-[88px]">
        <a href="/" class="shrink-0" aria-label={`${BUSINESS.name} home`}>
          <img src="/dotty-bobbin-logo.png" alt={BUSINESS.name} width="698" height="175" class="h-11 w-auto sm:h-14" />
        </a>

        <nav class="hidden items-center gap-0.5 lg:flex xl:gap-1" aria-label="Main">
          {NAV.map((item) => (
            <a
              href={item.href}
              aria-current={isActive(item.href) ? "page" : undefined}
              class:list={[
                "whitespace-nowrap rounded-control px-2.5 py-2 text-sm font-semibold no-underline transition-colors xl:px-3.5 xl:text-[15px]",
                isActive(item.href) ? "bg-secondary text-sage-deep" : "text-foreground hover:bg-secondary",
              ]}
            >
              {item.label}
            </a>
          ))}
        </nav>

        <div class="flex shrink-0 items-center gap-1 sm:gap-2">
          <AccountLink client:only="react" />
          <CartButton client:only="react" />
          <details class="group relative lg:hidden" id="mobile-menu">
            <summary class="flex h-10 w-10 cursor-pointer list-none items-center justify-center rounded-full text-foreground hover:bg-secondary [&::-webkit-details-marker]:hidden" aria-label="Menu">
              <svg class="group-open:hidden" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
              <svg class="hidden group-open:block" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
            </summary>
            <nav class="absolute right-0 top-12 w-64 rounded-lg border border-border bg-background p-2 shadow-xl" aria-label="Main">
              {NAV.map((item) => (
                <a
                  href={item.href}
                  aria-current={isActive(item.href) ? "page" : undefined}
                  class:list={[
                    "block rounded-md px-4 py-3 font-semibold no-underline",
                    isActive(item.href) ? "bg-secondary text-sage-deep" : "hover:bg-secondary",
                  ]}
                >
                  {item.label}
                </a>
              ))}
              <a
                href="/gift-card"
                aria-current={isActive("/gift-card") ? "page" : undefined}
                class:list={["block rounded-md px-4 py-3 font-semibold no-underline", isActive("/gift-card") ? "bg-secondary text-sage-deep" : "hover:bg-secondary"]}
              >
                Gift cards
              </a>
              <div class="mt-1 border-t border-border pt-1">
                <AccountLink client:only="react" variant="menu" />
              </div>
            </nav>
          </details>
        </div>
      </div>
    </header>

    <main id="main" class:list={["flex-1", !bare && "pb-20 pt-5 sm:pt-8"]}>
      {path !== "/" && (
        <div class="wrap mb-4 sm:mb-5">
          <a href={backHref} id="back-link" class="-ml-2 inline-flex items-center gap-1 rounded-control px-2 py-1.5 text-sm font-semibold text-muted-foreground no-underline transition-colors hover:bg-secondary hover:text-sage-deep">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6" /></svg>
            Back
          </a>
        </div>
      )}
      <slot />
    </main>

    <footer class="mt-auto bg-secondary">
      <div class="wrap grid gap-10 py-14 md:grid-cols-[1.4fr_1fr_1fr]">
        <div>
          <img src="/dotty-bobbin-logo.png" alt={BUSINESS.name} width="698" height="175" class="h-11 w-auto" loading="lazy" />
          <p class="mt-4 max-w-xs text-sm text-muted-foreground">Sewing classes, retreats and days out in Felden, Hemel Hempstead.</p>
        </div>
        <div>
          <p class="eyebrow">Find me</p>
          <address class="mt-3 text-sm not-italic leading-relaxed">
            {BUSINESS.address.map((line) => <span class="block">{line}</span>)}
          </address>
          <a href={`mailto:${BUSINESS.email}`} class="mt-3 inline-block text-sm font-semibold underline decoration-blush decoration-2 underline-offset-4">{BUSINESS.email}</a>
          {BUSINESS.showPhone && <p class="mt-1 text-sm">{BUSINESS.phone}</p>}
          {BUSINESS.facebook && <a href={BUSINESS.facebook} target="_blank" rel="noopener" class="mt-2 block text-sm font-semibold no-underline hover:underline">Facebook</a>}
        </div>
        <div>
          <p class="eyebrow">Menu</p>
          <ul class="mt-3 space-y-1.5 text-sm">
            {NAV.map((item) => <li><a href={item.href} class="no-underline hover:underline">{item.label}</a></li>)}
            <li><a href="/gift-card" class="no-underline hover:underline">Gift cards</a></li>
            <li><a href="/account" class="no-underline hover:underline">My account</a></li>
          </ul>
        </div>
      </div>
      <div class="border-t border-border">
        <div class="wrap flex flex-col gap-2 py-5 text-xs text-muted-foreground sm:flex-row sm:items-center sm:justify-between">
          <p>© {year} {BUSINESS.name}</p>
          <a href="/policies" class="no-underline hover:underline">Terms &amp; Conditions</a>
        </div>
      </div>
    </footer>

    <CartDrawer client:only="react" />

    <script>
      // Close the mobile menu on Escape, a tap outside it, or after picking a link (delegated: the
      // account link is an island that renders after this runs).
      const menu = document.getElementById("mobile-menu") as HTMLDetailsElement | null;
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && menu?.open) {
          menu.open = false;
          menu.querySelector("summary")?.focus();
        }
      });
      document.addEventListener("click", (e) => {
        if (menu?.open && e.target instanceof Node && !menu.contains(e.target)) menu.open = false;
      });
      menu?.addEventListener("click", (e) => {
        if (e.target instanceof Element && e.target.closest("nav a")) menu.open = false;
      });

      // "Copy email address" buttons (data-copy="…"): hidden until the browser can copy, then
      // copy and say "Copied" for a moment. Without it the mailto link and the printed address remain.
      document.querySelectorAll<HTMLButtonElement>("button[data-copy]").forEach((btn) => {
        if (!navigator.clipboard?.writeText) return;
        const label = btn.textContent;
        let timer: number | undefined;
        btn.hidden = false;
        btn.addEventListener("click", async () => {
          try {
            await navigator.clipboard.writeText(btn.dataset.copy ?? "");
            btn.textContent = "Copied";
          } catch {
            btn.textContent = "Couldn't copy";
          }
          clearTimeout(timer);
          timer = window.setTimeout(() => (btn.textContent = label), 2000);
        });
      });

      // Back: the previous page when it was a page of this site, else the link's own parent page.
      document.getElementById("back-link")?.addEventListener("click", (e) => {
        let sameSite = false;
        try {
          sameSite = !!document.referrer && new URL(document.referrer).origin === location.origin;
        } catch {}
        if (sameSite && history.length > 1) {
          e.preventDefault();
          history.back();
        }
      });
    </script>
  </body>
</html>
